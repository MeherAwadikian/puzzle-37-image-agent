# Supabase project (REST + Storage)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<service_role key — server-side only, bypasses RLS for writes; never ship to a client>

# LLM used by the art-director agent step (any OpenAI-compatible endpoint works;
# this demo used OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-...
